PORT=4000
# Local docker-compose PostgreSQL. Supabase: use its Session pooler (5432) or
# Transaction pooler (6543) for DATABASE_URL; transaction-pooler URLs may need
# pgbouncer=true for Prisma 6. Use the direct database URL for DIRECT_URL/migrations.
# Keep sslmode=require on remote Supabase URLs. Never commit real credentials.
DATABASE_URL=postgresql://campuslink:campuslink@localhost:5432/campuslink
DIRECT_URL=postgresql://campuslink:campuslink@localhost:5432/campuslink
# Generate with a cryptographically secure random generator; minimum 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REFRESH_COOKIE_NAME=campuslink_refresh
REFRESH_COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173
LAUNCH_UNIVERSITY_SLUG=university-of-kabianga
