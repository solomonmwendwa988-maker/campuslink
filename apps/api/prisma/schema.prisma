generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum NotificationType {
  LIKE
  COMMENT
  REPLY
  REPOST
  FOLLOW
  MESSAGE
  EVENT
}

model University {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  country   String    @default("Kenya")
  active    Boolean   @default(true)
  campuses  Campus[]
  profiles  Profile[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Campus {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @db.Uuid
  name         String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  profiles     Profile[]
  listings     Listing[]
  events       Event[]
  @@unique([universityId, name])
  @@index([universityId])
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  email              String        @unique
  username           String        @unique
  passwordHash       String
  role               UserRole       @default(USER)
  emailVerifiedAt    DateTime?
  deactivatedAt      DateTime?
  suspendedAt        DateTime?
  suspensionReason   String?   @db.VarChar(500)
  deletedAt          DateTime?
  profile            Profile?
  sessions           RefreshSession[]
  posts              Post[]
  comments           Comment[]
  commentLikes        CommentLike[]
  likes              Like[]
  bookmarks          Bookmark[]
  reposts            Repost[]
  postViews          PostView[]
  follows            Follow[]      @relation("follower")
  followedBy         Follow[]      @relation("followed")
  memberships        ConversationParticipant[]
  conversationMutes ConversationMute[]
  accountMutesMade AccountMute[] @relation("accountMuteOwner")
  accountMutesReceived AccountMute[] @relation("accountMutedTarget")
  messages           Message[]
  messageReactions   MessageReaction[]
  listings           Listing[]
  favorites          ListingFavorite[]
  events             Event[]
  eventInterests     EventInterest[]
  notifications      Notification[] @relation("notificationRecipient")
  reports            Report[]      @relation("reporter")
  verificationRequests VerificationRequest[]
  blocksMade         Block[]       @relation("blocker")
  blocksReceived     Block[]       @relation("blocked")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  @@index([deletedAt, createdAt])
  @@index([deletedAt, deactivatedAt, createdAt(sort: Desc), id])
}

model Profile {
  userId       String     @id @db.Uuid
  universityId String     @db.Uuid
  campusId     String     @db.Uuid
  fullName     String
  course       String
  yearOfStudy  Int
  bio          String?    @db.VarChar(500)
  photoUrl     String?
  coverUrl     String?
  interests    String[]   @default([])
  skills       String[]   @default([])
  isPrivate    Boolean    @default(false)
  verifiedAt   DateTime?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  campus       Campus     @relation(fields: [campusId], references: [id], onDelete: Restrict)
  @@index([universityId, campusId])
}

model VerificationRequest {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  email             String
  phone             String
  fullName           String
  course             String
  campus             String
  reason             String              @db.VarChar(800)
  studentIdHash     String
  status            VerificationStatus  @default(PENDING)
  submittedAt        DateTime            @default(now())
  reviewedAt         DateTime?
  reviewerId         String?             @db.Uuid
  reviewNote         String?             @db.VarChar(500)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, submittedAt])
}

model RefreshSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt, expiresAt])
}

model Post {
  id        String      @id @default(uuid()) @db.Uuid
  authorId  String      @db.Uuid
  content   String      @db.VarChar(3000)
  deletedAt DateTime?
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media     PostMedia[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  reposts   Repost[]
  views     PostView[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  @@index([createdAt(sort: Desc), id])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([deletedAt, createdAt(sort: Desc), id])
}

model PostView {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@index([postId, createdAt])
}


model PostMedia {
  id        String @id @default(uuid()) @db.Uuid
  postId    String @db.Uuid
  url       String
  position  Int    @default(0)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId, position])
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @db.Uuid
  authorId  String    @db.Uuid
  parentId  String?   @db.Uuid
  content   String    @db.VarChar(1500)
  deletedAt DateTime?
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("replies")
  likes    CommentLike[]
  createdAt DateTime  @default(now())
  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([postId, parentId, deletedAt, createdAt(sort: Desc), id])
}

model Like {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@index([postId, createdAt])
}

model Bookmark {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
}

model CommentLike {
  userId    String   @db.Uuid
  commentId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  @@id([userId, commentId])
  @@index([commentId, createdAt])
}

model Repost {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@index([postId, createdAt])
}

model Follow {
  followerId String   @db.Uuid
  followedId String   @db.Uuid
  createdAt  DateTime @default(now())
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("followed", fields: [followedId], references: [id], onDelete: Cascade)
  @@id([followerId, followedId])
  @@index([followedId, createdAt])
}

model Conversation {
  id           String                      @id @default(uuid()) @db.Uuid
  directKey    String?                     @unique
  participants ConversationParticipant[]
  messages     Message[]
  mutes        ConversationMute[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model ConversationParticipant {
  conversationId String @db.Uuid
  userId         String @db.Uuid
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
}

model AccountMute {
  userId String @db.Uuid
  mutedUserId String @db.Uuid
  createdAt DateTime @default(now())
  user User @relation("accountMuteOwner", fields: [userId], references: [id], onDelete: Cascade)
  mutedUser User @relation("accountMutedTarget", fields: [mutedUserId], references: [id], onDelete: Cascade)
  @@id([userId, mutedUserId])
  @@index([mutedUserId])
}

model ConversationMute {
  conversationId String @db.Uuid
  userId String @db.Uuid
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId, createdAt])
}


model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  senderId       String   @db.Uuid
  clientMessageId String? @db.VarChar(100)
  content        String   @db.VarChar(5000)
  readAt         DateTime?
  deliveredAt    DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]
  reactions      MessageReaction[]
  createdAt      DateTime @default(now())
  @@index([conversationId, createdAt(sort: Desc), id])
  @@index([senderId, createdAt])
  @@unique([senderId, clientMessageId])
}

model MessageAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  url       String
  mediaType String   @db.VarChar(100)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([messageId])
}

model MessageReaction {
  userId    String   @db.Uuid
  messageId String   @db.Uuid
  reaction  String   @db.VarChar(32)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, messageId])
}

model Listing {
  id          String           @id @default(uuid()) @db.Uuid
  sellerId    String           @db.Uuid
  campusId    String           @db.Uuid
  title       String           @db.VarChar(120)
  description String           @db.VarChar(3000)
  category    String           @db.VarChar(60)
  price       Decimal          @db.Decimal(10, 2)
  condition   ListingCondition
  available   Boolean          @default(true)
  deletedAt   DateTime?
  seller      User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  campus      Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  favorites   ListingFavorite[]
  images      ListingImage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@index([campusId, available, createdAt(sort: Desc)])
  @@index([category, price])
  @@index([campusId, available, deletedAt, createdAt(sort: Desc), id])
}

model ListingFavorite {
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@id([userId, listingId])
}

model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @db.Uuid
  url       String
  position  Int      @default(0)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@index([listingId, position])
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  campusId    String   @db.Uuid
  title       String   @db.VarChar(120)
  description String   @db.VarChar(3000)
  category    String   @db.VarChar(60)
  venue       String   @db.VarChar(180)
  startsAt    DateTime
  endsAt      DateTime
  imageUrl    String?
  deletedAt   DateTime?
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  interests   EventInterest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([campusId, startsAt])
  @@index([campusId, deletedAt, startsAt, id])
}

model EventInterest {
  userId    String   @db.Uuid
  eventId   String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@id([userId, eventId])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @db.Uuid
  actorId     String?          @db.Uuid
  type        NotificationType
  entityId    String?          @db.Uuid
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([recipientId, readAt, createdAt(sort: Desc)])
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @db.Uuid
  targetType String       @db.VarChar(30)
  targetId   String       @db.Uuid
  reason     String       @db.VarChar(80)
  details    String?      @db.VarChar(1000)
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  reporter   User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@unique([reporterId, targetType, targetId])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model MessagingPresence {
  userId               String   @id @db.Uuid
  lastSeenAt            DateTime @default(now())
  typingConversationId  String?  @db.Uuid
  typingUntil           DateTime?
  updatedAt              DateTime @updatedAt
  @@index([lastSeenAt])
  @@index([typingConversationId, typingUntil])
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(40)
  entityId    String?  @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

/// Append-only platform event stream. Metadata must contain only non-sensitive context.
model ActivityEvent {
  id               String   @id @default(uuid()) @db.Uuid
  eventType        String   @db.VarChar(80)
  category         String   @db.VarChar(40)
  outcome          String?  @db.VarChar(24)
  actorUserId      String?  @db.Uuid
  targetType       String?  @db.VarChar(40)
  targetId         String?  @db.VarChar(80)
  maskedIdentifier String?  @db.VarChar(160)
  metadata         Json?
  createdAt        DateTime @default(now())
  @@index([createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([outcome, createdAt(sort: Desc)])
}
